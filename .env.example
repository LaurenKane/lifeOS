# Life OS — environment template. PLACEHOLDERS ONLY. Never commit a real value.
#
# Copy to `.env` (gitignored) and edit there:
#     cp .env.example .env
#
# SAFETY.md rule 3: credentials never live inside this repository. The Enable
# Banking RSA private key belongs in the OS keyring or `~/.config/lifeos/eb/`,
# which is outside this working tree. Nothing in this file is a secret — every
# value below is either a local development default or an empty placeholder for
# a non-secret identifier you are expected to fill in.

# ---------------------------------------------------------------------------
# Compose project name. Baked into the Makefile, set here so a bare
# `docker compose` invocation in this directory is namespaced too. MUST be
# `lifeos`: this machine also runs unrelated stacks (a Supabase set for
# LifeManager and a `financeapp` project) whose volumes must never be touched.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=lifeos

# ---------------------------------------------------------------------------
# Postgres (development only — these are throwaway local credentials)
# ---------------------------------------------------------------------------
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_DB=lifeos

# Host-published ports. Bound to 127.0.0.1 by default: this is a single-user
# personal app and the documented topology (docs/adr/0001) is Docker Compose
# behind Tailscale, not a public listener.
LIFEOS_API_PORT=8000
LIFEOS_FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Backend settings. Read by `config.LifeOSettings` with the LIFEOS_ prefix.
# `LIFEOS_DATABASE_URL` must use the compose service name `db`, not localhost:
# inside a container, localhost is that container.
# ---------------------------------------------------------------------------
LIFEOS_DATABASE_URL=postgresql://lifeos:lifeos@db:5432/lifeos
LIFEOS_DEBUG=false

# Where the api keeps uploaded Vision images (a named compose volume, `media`).
LIFEOS_MEDIA_DIR=/data/media

# Note: main.py does not install CORSMiddleware yet, so this list is currently
# inert — it becomes load-bearing the moment the middleware is added. Keep the
# Vite dev server's origin (http://localhost:5173) in it at that point, or the
# browser will block every request from the dev server.
LIFEOS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# ---------------------------------------------------------------------------
# External identifiers (non-secret, but record them outside the repo the moment
# they are issued — SAFETY.md rule 4).
# ---------------------------------------------------------------------------
LIFEOS_APP_ID=
LIFEOS_ENABLE_BANKING_CLIENT_ID=

# ---------------------------------------------------------------------------
# Frontend build-time configuration.
#
# VITE_API_BASE_URL is BAKED INTO THE BUNDLE AT BUILD TIME by Vite's
# import.meta.env substitution. It is NOT a runtime env var: setting it on the
# `frontend` container at runtime does nothing, because the running server only
# serves already-built static files. To change it, rebuild with a different
# build arg (see `make frontend-build` / the Dockerfile ARG).
#
# `/api` is root-relative and is the right value for the compose stack: the
# nginx config proxies /api to the api service, so no host is baked in.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# Path to the Enable Banking private key, OUTSIDE the repository. Referenced by
# `tools/probe_aspsps.py`; the value is a path, never the key material.
EB_PRIVATE_KEY_PATH=
EB_CERTIFICATE_PATH=